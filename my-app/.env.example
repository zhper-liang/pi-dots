# Server-only. Generate a fresh token using the command in README.md.
# Never prefix this setting with VITE_. Never use a model API key here.
PIDOT_API_TOKEN=
PIDOT_API_PORT=3001
# Optional SQLite file; default: my-app/data/pidot.sqlite
# PIDOT_DB_PATH=/absolute/path/to/pidot.sqlite

# Server-only model configuration falls back to ../.env (base_url, MODEL, OPENAI_API_KEY).
# Never use VITE_ variables for these values. Explicit environment wins.
# PIDOT_REPLY_MODE=model
# OPENAI_BASE_URL=https://www.bb-api.com/v1
# MODEL=deepseek-v4.1-flash
# OPENAI_API_KEY=
# Use PIDOT_REPLY_MODE=test to isolate offline tests from ../.env.

# Defaults for NEW Tasks only. Counters accumulate for the entire Task lifetime.
# PIDOT_DEFAULT_MODEL_CALLS=20
# PIDOT_DEFAULT_TOOL_CALLS=10
# Optional receipt-based token threshold; unset means no token threshold.
# PIDOT_DEFAULT_TOTAL_TOKENS=100000
# Per-request output bound (1–32768); not a precise billing cap.
# PIDOT_MAX_OUTPUT_TOKENS=4096

# Verified per-model capacity policy for NEW Tasks only. No guessed default.
# JSON maps exact model IDs to context capacity in tokens (8192–4000000).
# Use the provider's verified capacity, or an explicitly smaller application budget.
# Unknown/unlisted models and existing snapshots remain unconfigured (UI shows this).
# PIDOT_CONTEXT_WINDOWS={"your-verified-model-id":128000}
